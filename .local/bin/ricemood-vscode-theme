def textmate_rules(c: dict[str, str], t: dict[str, str]) -> list[dict[str, object]]:
    return [
        {"scope": ["comment", "punctuation.definition.comment"], "settings": {"foreground": c["outline"], "fontStyle": "italic"}},
        {"scope": ["string", "string.quoted", "string.template"], "settings": {"foreground": t["color10"]}},
        {"scope": ["constant.numeric", "constant.language", "constant.character"], "settings": {"foreground": c["tertiary"]}},
        {"scope": ["keyword", "storage.type", "storage.modifier"], "settings": {"foreground": c["primary"]}},
        {"scope": ["entity.name.type", "entity.name.class", "entity.name.interface", "support.type"], "settings": {"foreground": c["tertiary_fixed_dim"]}},
        {"scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": {"foreground": c["primary_fixed"]}},
        {"scope": ["variable", "meta.object-literal.key", "support.variable.property"], "settings": {"foreground": c["on_surface"]}},
        {"scope": ["variable.parameter"], "settings": {"foreground": c["secondary"]}},
        {"scope": ["entity.name.tag"], "settings": {"foreground": c["primary"]}},
        {"scope": ["entity.other.attribute-name"], "settings": {"foreground": c["tertiary"]}},
        {"scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator"], "settings": {"foreground": c["on_surface_variant"]}},
        {"scope": ["invalid", "invalid.illegal"], "settings": {"foreground": c["on_error_container"], "background": c["error_container"]}},
        {"scope": ["markup.heading", "markup.bold"], "settings": {"foreground": c["primary_fixed"], "fontStyle": "bold"}},
        {"scope": ["markup.italic"], "settings": {"foreground": c["secondary"], "fontStyle": "italic"}},
        {"scope": ["markup.inline.raw", "markup.fenced_code.block"], "settings": {"foreground": t["color10"]}},
    ]


def semantic_rules(c: dict[str, str]) -> dict[str, object]:
    return {
        "namespace": c["tertiary"],
        "type": c["tertiary_fixed_dim"],
        "class": {"foreground": c["tertiary_fixed_dim"], "bold": True},
        "interface": c["tertiary_fixed_dim"],
        "enum": c["primary"],
        "enumMember": c["tertiary"],
        "typeParameter": c["secondary"],
        "function": c["primary_fixed"],
        "method": c["primary_fixed"],
        "property": c["on_surface"],
        "variable": c["on_surface"],
        "variable.readonly": c["tertiary"],
        "parameter": c["secondary"],
        "decorator": c["primary"],
        "keyword": c["primary"],
        "string": c["secondary_fixed_dim"],
        "number": c["tertiary"],
        "regexp": c["tertiary_fixed"],
        "operator": c["on_surface_variant"],
        "comment": {"foreground": c["outline"], "italic": True},
    }


def update_settings() -> bool:
    colors, terminal = load_colors()
    SETTINGS_PATH.parent.mkdir(parents=True, exist_ok=True)

    if SETTINGS_PATH.exists():
        with SETTINGS_PATH.open(encoding="utf-8") as handle:
            settings = json.load(handle)
        mode = stat.S_IMODE(SETTINGS_PATH.stat().st_mode)
    else:
        settings = {}
        mode = 0o600

    settings.update({
        "workbench.colorTheme": "Default Dark Modern",
        "workbench.preferredDarkColorTheme": "Default Dark Modern",
        "window.autoDetectColorScheme": False,
        "editor.fontFamily": "'JetBrains Mono', 'Noto Color Emoji', monospace",
        "editor.fontLigatures": True,
        "terminal.integrated.fontFamily": "JetBrains Mono",
        "debug.console.fontFamily": "JetBrains Mono",
        "editor.semanticHighlighting.enabled": True,
        "editor.bracketPairColorization.enabled": True,
        "workbench.colorCustomizations": workbench_colors(colors, terminal),
        "editor.tokenColorCustomizations": {"textMateRules": textmate_rules(colors, terminal)},
        "editor.semanticTokenColorCustomizations": {"enabled": True, "rules": semantic_rules(colors)},
    })

    ignored = settings.get("settingsSync.ignoredSettings", [])
    if not isinstance(ignored, list):
        ignored = []
    for key in (
        "workbench.colorCustomizations",
        "editor.tokenColorCustomizations",
        "editor.semanticTokenColorCustomizations",
    ):
        if key not in ignored:
            ignored.append(key)
    settings["settingsSync.ignoredSettings"] = ignored

    rendered = json.dumps(settings, indent=4, ensure_ascii=False) + "\n"
    if SETTINGS_PATH.exists() and SETTINGS_PATH.read_text(encoding="utf-8") == rendered:
        return False

    temporary = SETTINGS_PATH.with_name(SETTINGS_PATH.name + ".ricemood-tmp")
    temporary.write_text(rendered, encoding="utf-8")
    os.chmod(temporary, mode)
    os.replace(temporary, SETTINGS_PATH)
    return True


if __name__ == "__main__":
    changed = update_settings()
    print(f"ricemood-vscode: {'updated' if changed else 'already current'}")
