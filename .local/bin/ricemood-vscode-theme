#!/usr/bin/env python3
"""Project the current RiceMood palette into VS Code user settings."""

from __future__ import annotations

import json
import os
from pathlib import Path
import re
import stat


PALETTE_PATH = Path.home() / ".cache" / "DankMaterialShell" / "dms-colors.json"
SETTINGS_PATH = Path.home() / ".config" / "Code" / "User" / "settings.json"
HEX_COLOR = re.compile(r"^#[0-9a-fA-F]{6}$")


def alpha(color: str, opacity: int) -> str:
    return f"{color}{opacity:02x}"


def blend(foreground: str, background: str, weight: float) -> str:
    foreground_rgb = [int(foreground[index:index + 2], 16) for index in (1, 3, 5)]
    background_rgb = [int(background[index:index + 2], 16) for index in (1, 3, 5)]
    return "#" + "".join(
        f"{round(front * weight + back * (1 - weight)):02x}"
        for front, back in zip(foreground_rgb, background_rgb)
    )


def load_colors() -> tuple[dict[str, str], dict[str, str]]:
    with PALETTE_PATH.open(encoding="utf-8") as handle:
        palette = json.load(handle)

    colors = palette["colors"]["dark"]
    terminal = {
        name: palette["dank16"][name]["dark"]
        for name in (f"color{index}" for index in range(16))
    }
    if not all(HEX_COLOR.fullmatch(value) for value in (*colors.values(), *terminal.values())):
        raise ValueError("RiceMood produced an invalid color value")
    return colors, terminal


