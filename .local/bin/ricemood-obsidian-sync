#!/usr/bin/env bash

set -euo pipefail

palette_file="${XDG_CACHE_HOME:-${HOME}/.cache}/DankMaterialShell/dms-colors.json"
session_file="${XDG_STATE_HOME:-${HOME}/.local/state}/DankMaterialShell/session.json"
vault_root="${OBSIDIAN_VAULT:-${HOME}/Documents/Obsidian/Purdue}"
snippet_dir="${vault_root}/.obsidian/snippets"
snippet_file="${snippet_dir}/ricemood.css"

if [[ ! -s "${palette_file}" || ! -s "${session_file}" ]]; then
    echo "Ricemood palette or DMS session state is unavailable." >&2
    exit 1
fi

mode="$(jq -er 'if .isLightMode == true then "light" else "dark" end' "${session_file}")"

mapfile -t colors < <(
    jq -er --arg mode "${mode}" '
        .colors[$mode] as $color
        | [
            $color.background,
            $color.on_background,
            $color.surface,
            $color.surface_dim,
            $color.surface_bright,
            $color.surface_container_lowest,
            $color.surface_container_low,
            $color.surface_container,
            $color.surface_container_high,
            $color.surface_container_highest,
            $color.on_surface,
            $color.on_surface_variant,
            $color.primary,
            $color.on_primary,
            $color.primary_container,
            $color.on_primary_container,
            $color.secondary,
            $color.on_secondary,
            $color.secondary_container,
            $color.on_secondary_container,
            $color.tertiary,
            $color.on_tertiary,
            $color.tertiary_container,
            $color.on_tertiary_container,
            $color.error,
            $color.on_error,
            $color.error_container,
            $color.outline,
            $color.outline_variant,
            $color.inverse_surface,
            $color.inverse_on_surface,
            $color.shadow,
            $color.scrim
        ]
        | if all(.[]; type == "string" and test("^#[0-9a-fA-F]{6}$"))
          then .[]
          else error("DMS palette contains an invalid color")
          end
    ' "${palette_file}"
)

if (( ${#colors[@]} != 33 )); then
    echo "DMS palette did not provide the expected colors." >&2
    exit 1
fi

background="${colors[0]}"
on_background="${colors[1]}"
surface="${colors[2]}"
surface_dim="${colors[3]}"
surface_bright="${colors[4]}"
surface_lowest="${colors[5]}"
surface_low="${colors[6]}"
surface_container="${colors[7]}"
surface_high="${colors[8]}"
surface_highest="${colors[9]}"
on_surface="${colors[10]}"
on_surface_variant="${colors[11]}"
primary="${colors[12]}"
on_primary="${colors[13]}"
primary_container="${colors[14]}"
on_primary_container="${colors[15]}"
secondary="${colors[16]}"
on_secondary="${colors[17]}"
secondary_container="${colors[18]}"
on_secondary_container="${colors[19]}"
tertiary="${colors[20]}"
on_tertiary="${colors[21]}"
tertiary_container="${colors[22]}"
on_tertiary_container="${colors[23]}"
error="${colors[24]}"
on_error="${colors[25]}"
error_container="${colors[26]}"
outline="${colors[27]}"
outline_variant="${colors[28]}"
inverse_surface="${colors[29]}"
inverse_on_surface="${colors[30]}"
shadow="${colors[31]}"
scrim="${colors[32]}"

install -d -m 0700 "${snippet_dir}"
temporary_file="$(mktemp "${snippet_dir}/.ricemood.css.XXXXXX")"
trap 'rm -f "${temporary_file}"' EXIT

cat >"${temporary_file}" <<EOF
/* Generated by ricemood-obsidian-sync from the live DMS ${mode} palette.
 * Do not edit this file directly; it is replaced on palette and mode changes.
 */

.theme-dark,
.theme-light {
    color-scheme: ${mode};

    --font-interface-theme: "JetBrains Mono", monospace;
    --font-text-theme: "JetBrains Mono", monospace;
    --font-monospace-theme: "JetBrains Mono", monospace;

    --background-primary: ${background};
    --background-primary-alt: ${surface_low};
    --background-secondary: ${surface_container};
    --background-secondary-alt: ${surface_high};
    --background-modifier-form-field: ${surface_high};
    --background-modifier-form-field-highlighted: ${surface_highest};
    --background-modifier-border: ${outline_variant};
    --background-modifier-border-hover: ${outline};
    --background-modifier-border-focus: ${primary};
    --background-modifier-hover: color-mix(in srgb, ${on_surface} 8%, transparent);
    --background-modifier-active-hover: color-mix(in srgb, ${primary} 18%, transparent);
    --background-modifier-message: ${surface_high};
    --background-modifier-success: ${tertiary_container};
    --background-modifier-error: ${error_container};
    --background-modifier-error-hover: ${error};
    --background-modifier-cover: color-mix(in srgb, ${scrim} 58%, transparent);
    --background-modifier-box-shadow: ${shadow};

    --text-normal: ${on_surface};
    --text-muted: ${on_surface_variant};
    --text-faint: ${outline};
    --text-on-accent: ${on_primary};
    --text-on-accent-inverted: ${primary};
    --text-accent: ${primary};
    --text-accent-hover: ${on_primary_container};
    --text-success: ${tertiary};
    --text-warning: ${secondary};
    --text-error: ${error};
    --text-error-hover: ${error};
    --text-selection: color-mix(in srgb, ${primary} 28%, transparent);
    --text-highlight-bg: color-mix(in srgb, ${tertiary} 25%, transparent);
    --caret-color: ${primary};

    --interactive-normal: ${surface_container};
    --interactive-hover: ${surface_high};
    --interactive-accent: ${primary};
    --interactive-accent-hover: color-mix(in srgb, ${primary} 84%, ${on_primary});
    --interactive-success: ${tertiary};
    --color-accent: ${primary};
    --color-accent-1: ${primary_container};
    --color-accent-2: ${secondary};

    --titlebar-background: ${surface_dim};
    --titlebar-background-focused: ${surface_low};
    --titlebar-text-color: ${on_surface};
    --ribbon-background: ${surface_low};
    --ribbon-background-collapsed: ${surface_lowest};
    --status-bar-background: ${surface_low};
    --tab-container-background: ${surface_low};
    --tab-background-active: ${background};
    --tab-text-color: ${on_surface_variant};
    --tab-text-color-active: ${on_surface};
    --tab-text-color-focused-active: ${primary};
    --divider-color: ${outline_variant};
    --divider-color-hover: ${primary};

    --nav-item-color: ${on_surface_variant};
    --nav-item-color-hover: ${on_surface};
    --nav-item-color-active: ${on_primary_container};
    --nav-item-background-hover: color-mix(in srgb, ${on_surface} 7%, transparent);
    --nav-item-background-active: ${primary_container};
    --nav-indentation-guide-color: ${outline_variant};
    --vault-name-color: ${primary};
    --icon-color: ${on_surface_variant};
    --icon-color-hover: ${on_surface};
    --icon-color-active: ${primary};
    --icon-color-focused: ${primary};

    --h1-color: ${primary};
    --h2-color: ${primary};
    --h3-color: ${secondary};
    --h4-color: ${tertiary};
    --h5-color: ${on_surface_variant};
    --h6-color: ${outline};
    --link-color: ${primary};
    --link-color-hover: ${on_primary_container};
    --link-external-color: ${tertiary};
    --link-external-color-hover: ${on_tertiary_container};
    --link-unresolved-color: ${outline};
    --blockquote-border-color: ${primary};

    --tag-color: ${on_primary_container};
    --tag-background: ${primary_container};
    --tag-border-color: ${primary};
    --tag-color-hover: ${on_primary};
    --tag-background-hover: ${primary};
    --checkbox-color: ${primary};
    --checkbox-color-hover: ${primary_container};
    --checkbox-border-color: ${outline};
    --checkbox-marker-color: ${on_primary};

    --code-background: ${surface_low};
    --code-normal: ${on_surface};
    --code-comment: ${outline};
    --code-function: ${primary};
    --code-important: ${error};
    --code-keyword: ${secondary};
    --code-operator: ${tertiary};
    --code-property: ${on_surface_variant};
    --code-punctuation: ${outline_variant};
    --code-string: ${tertiary};
    --code-tag: ${error};
    --code-value: ${secondary};

    --table-border-color: ${outline_variant};
    --table-header-background: ${surface_high};
    --table-header-background-hover: ${surface_highest};
    --table-row-alt-background: ${surface_low};
    --table-row-background-hover: color-mix(in srgb, ${primary} 9%, transparent);
    --scrollbar-bg: transparent;
    --scrollbar-thumb-bg: color-mix(in srgb, ${on_surface_variant} 22%, transparent);
    --scrollbar-active-thumb-bg: color-mix(in srgb, ${primary} 45%, transparent);

    --graph-node: ${primary};
    --graph-node-unresolved: ${outline};
    --graph-node-focused: ${on_primary_container};
    --graph-node-tag: ${secondary};
    --graph-node-attachment: ${tertiary};
    --graph-line: ${outline_variant};
    --graph-background: ${background};

    --canvas-background: ${background};
    --canvas-card-label-color: ${on_surface_variant};
    --canvas-dot-pattern: ${outline_variant};
    --canvas-color: ${primary};
    --canvas-color-1: ${error};
    --canvas-color-2: ${secondary};
    --canvas-color-3: ${tertiary};
    --canvas-color-4: ${primary_container};
    --canvas-color-5: ${secondary_container};
    --canvas-color-6: ${tertiary_container};

    --color-base-00: ${background};
    --color-base-05: ${surface_dim};
    --color-base-10: ${surface_lowest};
    --color-base-20: ${surface_low};
    --color-base-25: ${surface_container};
    --color-base-30: ${surface_high};
    --color-base-35: ${surface_highest};
    --color-base-40: ${outline_variant};
    --color-base-50: ${outline};
    --color-base-60: ${on_surface_variant};
    --color-base-70: ${on_surface};
    --color-base-100: ${inverse_surface};
    --color-red: ${error};
    --color-orange: ${tertiary};
    --color-yellow: ${secondary};
    --color-green: ${tertiary};
    --color-cyan: ${secondary};
    --color-blue: ${primary};
    --color-purple: ${secondary};
    --color-pink: ${tertiary};
}

.theme-dark .cm-active,
.theme-light .cm-active {
    background-color: color-mix(in srgb, ${on_surface} 4%, transparent);
}

.theme-dark ::selection,
.theme-light ::selection {
    background: color-mix(in srgb, ${primary} 28%, transparent);
    color: ${on_background};
}

.theme-dark .modal,
.theme-light .modal,
.theme-dark .prompt,
.theme-light .prompt,
.theme-dark .menu,
.theme-light .menu,
.theme-dark .popover,
.theme-light .popover {
    background-color: ${surface_high};
    border-color: ${outline_variant};
}

.theme-dark .workspace-tab-header.is-active,
.theme-light .workspace-tab-header.is-active {
    box-shadow: inset 0 -2px 0 ${primary};
}

.theme-dark .suggestion-item.is-selected,
.theme-light .suggestion-item.is-selected {
    background-color: ${primary_container};
    color: ${on_primary_container};
}

.theme-dark .markdown-rendered mark,
.theme-light .markdown-rendered mark {
    background-color: color-mix(in srgb, ${tertiary} 28%, transparent);
    color: ${on_surface};
}

body {
    --font-interface: "JetBrains Mono", monospace;
    --font-text: "JetBrains Mono", monospace;
    --font-monospace: "JetBrains Mono", monospace;
}
EOF

chmod 0600 "${temporary_file}"

if [[ -f "${snippet_file}" ]] && cmp -s "${temporary_file}" "${snippet_file}"; then
    rm -f "${temporary_file}"
    trap - EXIT
    echo "Obsidian already matches the DMS ${mode} palette."
    exit 0
fi

mv -f "${temporary_file}" "${snippet_file}"
trap - EXIT

echo "Updated Obsidian from the DMS ${mode} palette: ${snippet_file}"
